## Test that llvm-bolt skips functions with exception handlers.
## Functions with UNW_FLAG_EHANDLER or UNW_FLAG_UHANDLER have handler
## data with embedded code offsets that would be corrupted by rewriting.

# RUN: yaml2obj %p/Inputs/exception-handler.yaml -o %t.exe
# RUN: llvm-bolt %t.exe -o %t.out.exe 2>&1 | FileCheck %s
# RUN: llvm-bolt %t.exe -o %t.gs.exe --pecoff-relocate-gs 2>&1 | \
# RUN:   FileCheck %s --check-prefix=GS
# RUN: printf "1 func_0x140001010 2 1 func_0x140001010 a 0 100\n" > %t.fdata
# RUN: llvm-bolt %t.exe -o %t.gs-rewrite.exe --pecoff-relocate-gs \
# RUN:   -data=%t.fdata -reorder-blocks=ext-tsp 2>&1 | \
# RUN:   FileCheck %s --check-prefix=GS-REWRITE

# CHECK: BOLT-INFO: processing PE/COFF binary
# CHECK: BOLT-INFO: parsed 3 .pdata entries
# CHECK: BOLT-INFO: 3 functions discovered from .pdata
# CHECK: BOLT-INFO: 1 functions with exception handlers (skipped)

# GS: BOLT-INFO: 1 functions use __GSHandlerCheck
# GS: BOLT-INFO: 3 functions discovered from .pdata
# GS: BOLT-INFO: 0 functions with exception handlers (skipped)

# GS-REWRITE: BOLT-INFO: 1 __GSHandlerCheck functions rewritten (1 in-place, 0 out-of-place)
